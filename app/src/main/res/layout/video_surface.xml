<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen video surface: a TextureView (moves and shrinks with the swipe-down gesture, applies the clip's rotation),
     no built-in controller (the Compose overlay draws play/pause and the seek bar), letterboxed to the real aspect ratio. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="#000000"
    app:keep_content_on_player_reset="true" />
