<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Heimish Messages</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:rgba(0,0,0,.1)}
html,body{height:100%;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f8f9fa}
.scr{position:fixed;inset:0;display:flex;flex-direction:column;background:#fff;transition:transform .28s ease}
.scr.hide-right{transform:translateX(100%)}
.scr.hide-left{transform:translateX(-30%);pointer-events:none}
/* toolbar */
.tb{height:60px;background:#fff;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;padding:0 4px;flex-shrink:0}
.tb-title{font-size:20px;font-weight:700;color:#202124;flex:1;padding:0 8px}
.tb-info{flex:1;padding:0 8px;cursor:pointer;min-width:0}
.tb-info h2{font-size:16px;font-weight:600;color:#202124;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tb-info p{font-size:12px;color:#5f6368;margin-top:1px}
.ib{background:none;border:none;color:#5f6368;cursor:pointer;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ib:active{background:rgba(0,0,0,.08)}
/* list */
#clist{flex:1;overflow-y:auto;background:#fff}
.ci{display:flex;align-items:center;padding:8px 16px;gap:14px;cursor:pointer;min-height:72px;border-bottom:.5px solid #f0f0f0;position:relative;overflow:hidden}
.ci:active{background:#f8f9fa}
.av{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden}
.ci-body{flex:1;min-width:0}
.ci-r1{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px}
.ci-name{font-size:16px;color:#202124;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ci-name.unread{font-weight:700}
.ci-time{font-size:12px;color:#9aa0a6;white-space:nowrap;margin-left:8px}
.ci-time.unread{color:#1a73e8;font-weight:600}
.ci-r2{display:flex;align-items:center;gap:6px}
.ci-snip{font-size:14px;color:#9aa0a6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.ci-snip.unread{color:#202124;font-weight:500}
.badge{background:#1a73e8;color:#fff;border-radius:50%;min-width:20px;height:20px;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 4px}
/* FAB */
#fab{position:fixed;bottom:24px;right:16px;height:56px;padding:0 20px 0 16px;background:#e8f0fe;border-radius:28px;display:flex;align-items:center;gap:10px;cursor:pointer;border:none;font-size:15px;font-weight:600;color:#1a73e8;box-shadow:0 2px 8px rgba(0,0,0,.2);z-index:10}
#fab:active{opacity:.8}
/* chat */
#S-chat{background:#f0f0f0}
.cbg{flex:1;overflow-y:auto;padding:8px;display:flex;flex-direction:column;gap:2px}
.dh{text-align:center;margin:8px 0}
.dh span{background:#fff;padding:4px 12px;border-radius:10px;font-size:12px;color:#5f6368;font-weight:500;box-shadow:0 1px 2px rgba(0,0,0,.1)}
.brow{display:flex}
.brow.out{justify-content:flex-end}
.brow.in{justify-content:flex-start;padding-right:60px}
.brow.out{padding-left:60px}
.bub{max-width:100%;border-radius:18px;overflow:hidden;font-size:15px;line-height:1.5}
.bub.in{background:#e9e9eb;border-bottom-left-radius:4px}
.bub.out{background:#c2e7ff;border-bottom-right-radius:4px}
.bub .bt{padding:10px 14px 2px;color:#202124;word-break:break-word;white-space:pre-wrap}
.bub .bf{padding:2px 12px 8px;font-size:11px;color:#5f6368;text-align:right}
.bub img{width:100%;max-width:260px;display:block;cursor:pointer}
/* compose */
.compose{background:#fff;border-top:1px solid #e0e0e0;padding:6px 8px 10px;display:flex;align-items:flex-end;gap:6px;flex-shrink:0}
.cinp-wrap{flex:1;background:#f0f0f0;border-radius:24px;display:flex;align-items:flex-end;padding:4px 6px 4px 14px}
.cinp{flex:1;background:none;border:none;font-size:15px;padding:9px 0;outline:none;resize:none;max-height:130px;min-height:38px;line-height:1.4;color:#202124;font-family:inherit}
.cinp::placeholder{color:#9aa0a6}
.sbtn{width:46px;height:46px;border-radius:50%;background:#1a73e8;border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.sbtn:active{opacity:.8}
/* overlay panels */
.panel{position:fixed;inset:0;z-index:100;background:#fff;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s ease}
.panel.open{transform:none}
.panel-body{flex:1;overflow-y:auto}
/* dropdown menu */
.menu{position:fixed;z-index:200;background:#fff;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.2);min-width:200px;display:none;overflow:hidden}
.menu.open{display:block}
.mi{padding:14px 20px;font-size:15px;color:#202124;cursor:pointer;display:flex;align-items:center}
.mi:active{background:#f8f9fa}
.mi.red{color:#d93025}
.msep{height:.5px;background:#e0e0e0}
/* settings rows */
.sr{display:flex;align-items:center;gap:16px;padding:14px 18px;border-bottom:.5px solid #f0f0f0;cursor:pointer;background:#fff}
.sr:active{background:#f8f9fa}
.sr-ic{color:#5f6368;width:24px;flex-shrink:0;display:flex}
.sr-txt{flex:1}
.sr-txt h3{font-size:15px;color:#202124;font-weight:400}
.sr-txt p{font-size:13px;color:#9aa0a6;margin-top:1px}
.arr{color:#9aa0a6}
/* toggle */
.tog{width:44px;height:26px;border-radius:13px;background:#1a73e8;position:relative;cursor:pointer;flex-shrink:0;border:none;transition:background .2s}
.tog::after{content:'';position:absolute;width:22px;height:22px;border-radius:50%;background:#fff;top:2px;right:2px;transition:right .2s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
.tog.off{background:#ccc}
.tog.off::after{right:20px}
/* search */
#sbar{display:none;background:#fff;padding:8px 14px 12px;border-bottom:1px solid #e0e0e0}
.sw{background:#f0f0f0;border-radius:24px;display:flex;align-items:center;padding:0 14px;gap:8px;height:44px}
.sw input{flex:1;background:none;border:none;font-size:15px;color:#202124;outline:none;font-family:inherit}
.sw input::placeholder{color:#9aa0a6}
/* lightbox */
#lb{position:fixed;inset:0;background:#000;z-index:300;display:none;flex-direction:column;align-items:center;justify-content:center}
#lb img{max-width:100%;max-height:100%;object-fit:contain}
/* toast */
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:rgba(32,33,36,.9);color:#fff;padding:10px 22px;border-radius:20px;font-size:14px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:500;white-space:nowrap}
#toast.on{opacity:1}
/* reply bar */
#rbar{display:none;background:#fff;border-top:1px solid #e0e0e0;padding:8px 12px;gap:10px;align-items:center}
#rbar-lbl{flex:1;border-left:3px solid #1a73e8;padding:4px 10px;background:#e8f0fe;border-radius:0 6px 6px 0}
#rbar-lbl b{display:block;font-size:12px;color:#1a73e8}
#rbar-lbl span{font-size:13px;color:#5f6368}
/* img preview */
#iprev{display:none;background:#fff;border-top:1px solid #e0e0e0;padding:8px 12px;gap:8px;align-items:center}
#ipimg{width:68px;height:68px;object-fit:cover;border-radius:10px}
/* attach */
#asheet{position:fixed;inset:0;z-index:100;display:none}
#abg{position:absolute;inset:0;background:rgba(0,0,0,.4)}
#abox{position:absolute;bottom:0;left:0;right:0;background:#fff;border-radius:24px 24px 0 0;padding:8px 0 32px}
.ash-bar{width:36px;height:4px;background:#e0e0e0;border-radius:2px;margin:12px auto 20px}
.agrid{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:0 12px}
.ach{display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;padding:8px 4px}
.ach:active{opacity:.7}
.ach-ic{width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center}
.ach span{font-size:12px;color:#202124;font-weight:500;text-align:center}
</style>
</head>
<body>

<!-- LIST SCREEN -->
<div class="scr" id="S-list">
  <div class="tb">
    <button class="ib" id="btn-profile" style="color:#5f6368">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
    </button>
    <span class="tb-title">Messages</span>
    <button class="ib" id="btn-search"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg></button>
    <button class="ib" id="btn-list-more"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg></button>
  </div>
  <div id="sbar"><div class="sw"><svg width="18" height="18" viewBox="0 0 24 24" fill="#9aa0a6"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg><input id="sinp" placeholder="Search conversations..." oninput="filterList(this.value)"></div></div>
  <div id="clist"></div>
  <button id="fab">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
    Start chat
  </button>
</div>

<!-- CHAT SCREEN -->
<div class="scr hide-right" id="S-chat">
  <div class="tb" id="chat-tb"></div>
  <div class="cbg" id="cbg"></div>
  <div id="rbar">
    <div id="rbar-lbl"><b></b><span></span></div>
    <button class="ib" id="btn-clear-reply"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
  </div>
  <div id="iprev">
    <img id="ipimg" src="">
    <button class="ib" id="btn-clear-img"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
  </div>
  <div class="compose">
    <input type="file" id="finp" accept="image/*" style="display:none">
    <button class="ib" id="btn-attach"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg></button>
    <div class="cinp-wrap">
      <textarea class="cinp" id="cinp" placeholder="Message" rows="1"></textarea>
    </div>
    <button class="sbtn" id="btn-send">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path id="send-ico" d="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z"/></svg>
    </button>
  </div>
</div>

<!-- SETTINGS PANEL -->
<div class="panel" id="P-sett">
  <div class="tb">
    <button class="ib" id="btn-close-sett"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button>
    <span class="tb-title">Settings</span>
  </div>
  <div class="panel-body" id="sett-body"></div>
</div>

<!-- PROFILE PANEL -->
<div class="panel" id="P-prof">
  <div class="tb">
    <button class="ib" id="btn-close-prof"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
  </div>
  <div class="panel-body" id="prof-body"></div>
</div>

<!-- DETAILS PANEL -->
<div class="panel" id="P-det">
  <div class="tb">
    <button class="ib" id="btn-close-det"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button>
    <span class="tb-title">Contact info</span>
  </div>
  <div class="panel-body" id="det-body"></div>
</div>

<!-- OVERLAYS -->
<div id="asheet"><div id="abg"></div><div id="abox"><div class="ash-bar"></div><div class="agrid" id="agrid"></div></div></div>
<div class="menu" id="menu-list" style="top:60px;right:6px"></div>
<div class="menu" id="menu-chat" style="top:60px;right:6px"></div>
<div class="menu" id="menu-ctx"></div>
<div id="lb"><button id="btn-lb-close" style="position:absolute;top:16px;right:16px;background:rgba(255,255,255,.15);border:none;color:#fff;border-radius:50%;width:42px;height:42px;cursor:pointer;display:flex;align-items:center;justify-content:center"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button><img id="lb-img" src=""></div>
<div id="toast"></div>

<script>
// ── DATA ──────────────────────────────────────────────────────────────────────
var COLORS=['#1F6F5C','#2E5E8C','#8C4A2E','#6A2E8C','#8C2E5E','#2E8C7A','#8C7A2E','#1A237E'];
function avc(s){var h=0;for(var i=0;i<(s||'').length;i++)h=(h*31+s.charCodeAt(i))>>>0;return COLORS[h%COLORS.length];}
function ini(s){return ((s||'?').trim()[0]||'?').toUpperCase();}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function fmtT(ms){if(!ms)return'';var d=new Date(ms);return d.toLocaleTimeString([],{hour:'numeric',minute:'2-digit'});}
function fmtD(ms){if(!ms)return'';var d=new Date(ms),n=new Date();if(d.toDateString()===n.toDateString())return fmtT(ms);var y=new Date();y.setDate(y.getDate()-1);if(d.toDateString()===y.toDateString())return'Yesterday';return d.toLocaleDateString([],{month:'short',day:'numeric'});}
function fmtDay(ms){if(!ms)return'';var d=new Date(ms),n=new Date();if(d.toDateString()===n.toDateString())return'Today';var y=new Date();y.setDate(y.getDate()-1);if(d.toDateString()===y.toDateString())return'Yesterday';return d.toLocaleDateString([],{weekday:'long',month:'long',day:'numeric'});}

var convs=[
  {id:1,name:'\u05d0\u05d1\u05e8\u05d4\u05dd \u05e4\u05e2\u05dc\u05d0\u05d8\u05e9\u05e2\u05e7',addr:'+13475551234',snip:'Hey, wie geits?',date:Date.now()-2*60000,unread:2},
  {id:2,name:"\u05d9\u05e9\u05e2\u05d9\u05d9' \u05de\u05e2\u05e8\u05e5",addr:'+13475559876',snip:'\u05d5\u05d5\u05d0\u05e1 \u05d2\u05d9\u05d9\u05d8 \u05e4\u05d0\u05e8',date:Date.now()-60*60000,unread:0},
  {id:3,name:'\u05dc\u05d9\u05e4\u05d0 \u05de\u05d0\u05e8\u05e7',addr:'+18455378946',snip:'Working SMS',date:Date.now()-86400000,unread:0,photo:'https://i.pravatar.cc/80?img=12'},
  {id:4,name:'22000',addr:'22000',snip:'Your verification code is 847291',date:Date.now()-2*86400000,unread:0},
  {id:5,name:'\u05de\u05e2\u05e0\u05d3\u05dc \u05d2\u05e8\u05d9\u05df',addr:'+13475557777',snip:'\u05e7\u05d5\u05de \u05e9\u05d5\u05d9\u05df!',date:Date.now()-3*86400000,unread:2},
];
var msgs={
  1:[{id:1,b:'Hey!',t:Date.now()-86400000*2,in:1},{id:2,b:'Hey!',t:Date.now()-86400000*2+60000,in:0},{id:3,b:'Hey, wie geits?',t:Date.now()-2*60000,in:1,unread:1}],
  2:[{id:4,b:'\u05e9\u05dc\u05d5\u05dd!',t:Date.now()-3*86400000,in:0},{id:5,b:'\u05d5\u05d5\u05d0\u05e1 \u05d2\u05d9\u05d9\u05d8 \u05e4\u05d0\u05e8',t:Date.now()-60*60000,in:1}],
  3:[{id:6,b:'Working SMS',t:Date.now()-86400000,in:1},{id:7,b:'',t:Date.now()-86400000+500,in:0,img:'https://picsum.photos/seed/m1/300/200'}],
  4:[{id:8,b:'Your verification code is 847291.',t:Date.now()-2*86400000,in:1}],
  5:[{id:9,b:'\u05d5\u05d5\u05d0\u05d5 \u05d1\u05d9\u05e1\u05d8\u05d5?',t:Date.now()-3*86400000,in:1,unread:1},{id:10,b:'\u05e7\u05d5\u05de \u05e9\u05d5\u05d9\u05df!',t:Date.now()-3*86400000+60000,in:1,unread:1}],
};
var aid=null,replyTo=null,pendImg=null;

// ── AVATAR ────────────────────────────────────────────────────────────────────
function mkAv(c,w){
  if(c.photo)return '<img src="'+c.photo+'" style="width:'+w+'px;height:'+w+'px;border-radius:50%;object-fit:cover;flex-shrink:0" onerror="this.style.display=\'none\'">';
  return '<div class="av" style="width:'+w+'px;height:'+w+'px;background:'+avc(c.addr)+';font-size:'+Math.floor(w*.38)+'px;flex-shrink:0">'+ini(c.name)+'</div>';
}

// ── LIST ──────────────────────────────────────────────────────────────────────
function renderList(list){
  var html='';
  list.forEach(function(c){
    html+='<div class="ci" data-id="'+c.id+'">'+mkAv(c,52)
      +'<div class="ci-body">'
      +'<div class="ci-r1"><span class="ci-name'+(c.unread?' unread':'')+'">'+esc(c.name)+'</span><span class="ci-time'+(c.unread?' unread':'')+'">'+fmtD(c.date)+'</span></div>'
      +'<div class="ci-r2"><span class="ci-snip'+(c.unread?' unread':'')+'">'+esc(c.snip)+'</span>'+(c.unread?'<span class="badge">'+c.unread+'</span>':'')+'</div>'
      +'</div></div>';
  });
  document.getElementById('clist').innerHTML=html||'<div style="padding:40px;text-align:center;color:#9aa0a6">No conversations</div>';
}
function filterList(q){
  var f=q.toLowerCase();
  renderList(f?convs.filter(function(c){return c.name.toLowerCase().includes(f)||c.addr.includes(f);}):convs);
}

// ── OPEN/CLOSE CHAT ───────────────────────────────────────────────────────────
function openChat(id){
  aid=id;
  var c=convs.find(function(x){return x.id===id;});
  if(!c)return;
  c.unread=0;
  renderList(convs);
  document.getElementById('S-list').classList.add('hide-left');
  document.getElementById('S-chat').classList.remove('hide-right');
  // build toolbar
  var tb=document.getElementById('chat-tb');
  tb.innerHTML='<button class="ib" id="btn-back"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button>'
    +mkAv(c,40)
    +'<div class="tb-info" id="btn-det"><h2>'+esc(c.name)+'</h2><p>'+esc(c.addr)+'</p></div>'
    +'<button class="ib" id="btn-chat-more"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg></button>';
  document.getElementById('btn-back').addEventListener('click',backToList);
  document.getElementById('btn-det').addEventListener('click',function(){openPanel('P-det');buildDet(id);});
  document.getElementById('btn-chat-more').addEventListener('click',function(e){e.stopPropagation();openMenu('menu-chat',e);});
  renderMsgs(id);
}
function backToList(){
  document.getElementById('S-list').classList.remove('hide-left');
  document.getElementById('S-chat').classList.add('hide-right');
  aid=null;clearReply();clearImg();closeAllMenus();
}

// ── MESSAGES ──────────────────────────────────────────────────────────────────
function renderMsgs(id){
  var list=msgs[id]||[];
  var html='';var lastDay='';var hasUnread=false;
  list.forEach(function(m){
    var day=fmtDay(m.t);
    if(day!==lastDay){html+='<div class="dh"><span>'+day+'</span></div>';lastDay=day;}
    if(m.unread&&!hasUnread){html+='<div class="dh" id="unread-mark"><span style="color:#1a73e8;font-weight:600">Unread</span></div>';hasUnread=true;}
    var inner='';
    if(m.img)inner+='<img src="'+m.img+'" data-src="'+m.img+'" onclick="openLb(this.dataset.src)">';
    if(m.b)inner+='<div class="bt">'+esc(m.b)+'</div>';
    var tick=m.in?'':'<span style="color:#1a73e8;font-size:10px">\u2713\u2713</span> ';
    inner+='<div class="bf">'+tick+fmtT(m.t)+(m.in?'':' \u2022 SMS')+'</div>';
    var rq=m.replyTo?'<div style="border-left:3px solid #1a73e8;margin:8px 10px 0;padding:5px 8px;background:rgba(26,115,232,.08);border-radius:0 6px 6px 0;font-size:13px;color:#5f6368">'+esc(m.replyTo)+'</div>':'';
    html+='<div class="brow '+(m.in?'in':'out')+'" data-id="'+m.id+'"><div class="bub '+(m.in?'in':'out')+'">'+rq+inner+'</div></div>';
  });
  if(!html)html='<div style="flex:1;display:flex;align-items:center;justify-content:center;padding:40px;color:#9aa0a6">No messages yet</div>';
  var bg=document.getElementById('cbg');
  bg.innerHTML=html;
  var um=bg.querySelector('#unread-mark');
  if(um)um.scrollIntoView({block:'center'});
  else bg.scrollTop=bg.scrollHeight;
  // long press on messages
  bg.querySelectorAll('.brow').forEach(function(el){
    var t;
    el.addEventListener('touchstart',function(e){t=setTimeout(function(){showMsgCtx(e,+el.dataset.id);},480);},{passive:true});
    el.addEventListener('touchend',function(){clearTimeout(t);},{passive:true});
    el.addEventListener('contextmenu',function(e){e.preventDefault();showMsgCtx(e,+el.dataset.id);});
  });
}

// ── SEND ──────────────────────────────────────────────────────────────────────
function sendMsg(){
  var inp=document.getElementById('cinp');
  var b=inp.value.trim();
  if(!b&&!pendImg)return;
  var m={id:Date.now(),b:b,t:Date.now(),in:0};
  if(pendImg)m.img=pendImg;
  if(replyTo)m.replyTo=replyTo;
  if(!msgs[aid])msgs[aid]=[];
  msgs[aid].push(m);
  var c=convs.find(function(x){return x.id===aid;});
  if(c){c.snip=b||(pendImg?'Photo':'');c.date=m.date;}
  inp.value='';inp.style.height='auto';
  clearReply();clearImg();
  document.getElementById('send-ico').setAttribute('d','M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z');
  renderMsgs(aid);renderList(convs);
  var _aid=aid;
  setTimeout(function(){
    if(aid!==_aid)return;
    var replies=['\u05d0\u05d5\u05e7\u05e2\u05d9!','\ud83d\udc4d','\u05e4\u05d0\u05e8\u05e9\u05d8\u05d0\u05e0\u05e2\u05df','\ud83d\ude0a','\u05d9\u05d0!','\ud83d\udc4c'];
    var r={id:Date.now()+1,b:replies[Math.floor(Math.random()*replies.length)],t:Date.now(),in:1};
    msgs[_aid].push(r);
    var cv=convs.find(function(x){return x.id===_aid;});
    if(cv){cv.snip=r.b;cv.date=r.t;}
    renderMsgs(_aid);renderList(convs);
  },1500);
}
function clearReply(){replyTo=null;document.getElementById('rbar').style.display='none';}
function clearImg(){pendImg=null;document.getElementById('iprev').style.display='none';document.getElementById('ipimg').src='';}

// ── PANELS ────────────────────────────────────────────────────────────────────
function openPanel(id){document.getElementById(id).classList.add('open');}
function closePanel(id){document.getElementById(id).classList.remove('open');}

function buildSett(){
  var html='<div style="background:#fff;margin-bottom:8px">';
  html+=srow('Notifications','Manage notification sounds & alerts','M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z');
  html+=srow('Bubbles','Control conversation bubbles','M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z');
  html+='</div><div style="background:#fff;margin-bottom:8px">';
